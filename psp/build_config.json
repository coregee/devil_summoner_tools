{
  "version": 1,
  "steps": [
    {
      "id": "repack_fonts",
      "description": "Generate the composed title-help, CONFIG, START2, and EVE font resources.",
      "type": "python",
      "script": "font/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "repack_text",
      "description": "Compile title-help, CONFIG/command help, and BTL_MES records into regdata.bin.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "repack_event_text",
      "description": "Compile the five canonical EVENT banks into the generated EVE font archive.",
      "type": "python",
      "script": "text/event_repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_fmv",
      "description": "Validate START2 and compile its canonical subtitles into runtime placements.",
      "type": "python",
      "script": "fmv/build.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_engine",
      "description": "Build title-help, CONFIG/command-help, EVENT VWF, BTL_MES, and START2 BOOT/EBOOT patches.",
      "type": "python",
      "script": "engine/build.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_disc",
      "description": "Publish the same-size PSP ISO and provenance manifest.",
      "type": "python",
      "script": "rom/repack.py",
      "arguments": ["game"],
      "check_arguments": ["game", "--check"]
    }
  ],
  "profiles": {
    "default": {
      "description": "Build every PSP surface currently ported into this repository.",
      "steps": [
        "repack_fonts",
        "repack_text",
        "repack_event_text",
        "build_fmv",
        "build_engine",
        "build_disc"
      ],
      "outputs": ["game"]
    }
  }
}
