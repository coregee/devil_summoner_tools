{
  "version": 1,
  "steps": [
    {
      "id": "repack_fonts",
      "description": "Generate the composed title-help and CONFIG font pages.",
      "type": "python",
      "script": "font/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "repack_text",
      "description": "Compile the title-help and CONFIG help records into regdata.bin.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_engine",
      "description": "Build the composed title-help and CONFIG BOOT/EBOOT patches.",
      "type": "python",
      "script": "engine/build.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_disc",
      "description": "Publish the same-size PSP ISO and provenance manifest.",
      "type": "python",
      "script": "rom/repack.py",
      "arguments": ["game"],
      "check_arguments": ["game", "--check"]
    }
  ],
  "profiles": {
    "default": {
      "description": "Build every PSP surface currently ported into this repository.",
      "steps": [
        "repack_fonts",
        "repack_text",
        "build_engine",
        "build_disc"
      ],
      "outputs": ["game"]
    }
  }
}
