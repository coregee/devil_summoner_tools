        {
          "start": 272,
          "characters": "々大種族神鬼魔飛天龍鳥獣精霊邪外"
        },
        {
          "start": 288,
          "characters": "道樹虫造人間女使妖凶秘幻聖御魂英雄王珍法死屍破壊地母夜堕幽悪攻撃前列威力敵体火炎系複数回横全氷結"
        },
        {
          "start": 336,
          "characters": "後電衝念動呪殺相性補助効果防命中能値無化復味方少程度員毒状態治療混乱至福睡眠魅了石沈黙麻痺変身解"
        },
        {
          "start": 384,
          "characters": "縛活最術者亡止物理反射戦闘参加特殊移時周辺表示脱出低現抑仲召喚月単詳細場離注文囲客会話商品購入売"
        },
        {
          "start": 432,
          "characters": "却新規装備更完一的増通常知恵速運過去倒代札意在個決定対象指未交換量試行設武器直接銃呼揮用隣発選択"
        },
        {
          "start": 480,
          "characters": "帰還内可以追避耐弾吸収位置編成戻元先側衛不存捨強部事除持生士守護肉働深血色宝愛輝平和払屈古来緑慈"
        },
        {
          "start": 528,
          "characters": "心育海贈鮮燃立勇気繊情見熱青澄危険遠苦悩消希望徴黄金具下階込寝昇長良川質水湯割分目甘崎酒六甲織絶"
        },
        {
          "start": 576,
          "characters": "妙日本各飲番芯幸配合湘南風僕子歌期限奴演山奥年作逸骨暖殴高級陽滋養壮病疲習船乗言伝安約束放惑第覚"
        },
        {
          "start": 624,
          "characters": "醒幅真赤料工業便利極寒思議彩包香好鉱別溶薬男背履歴書俺染世界賛説蛇漬費異属倍市朝区臨公園矢笠雲雀"
        },
        {
          "start": 672,
          "characters": "ヶ丘央図仮館東亜空院警察署学構乾社局博華街首領邸庁舎擬似獄墳迷宮削店銀座林修落誰令達口紅若我頂違"
        },
        {
          "start": 720,
          "characters": "十私必要上戴今何聞近耳憎考供自頭忘己逃策再二愉快勝負犬待許感足蝶浮実嫌故唯独尊然遊字慮粋嬉渡困断"
        },
        {
          "start": 768,
          "characters": "斐慢他仕次豊引取堅固貴殿有難素欲優幾短寄謝賢歳花同永忠誠誓礼晶恩義連兄老関貧乏返探偵師転職剣組手"
        },
        {
          "start": 816,
