  "sha256": "0bdfd6640b7ea3e792de2575cafcfae29aa86af12f0925f458b88ad533744dd7",
  "description": "Japanese name-entry font. The Latin letters, digits, punctuation, and selectable blank used by the English NAME.BIN grid are replaced in place with Ark Pixel 16px glyphs and published as the named ark_latin reference set. NAME.BIN uses the generated ink bounds to center them at runtime; the source cells themselves remain origin-aligned. NAME action controls remain compound FONT16 image glyphs rather than KANJI text.",
  "format": {
    "width": 16,
    "height": 16,
    "bpp": 1,
    "row_stride": 2,
    "glyph_stride": 32
  },
  "atlas": {
    "columns": 64,
    "scale": 1,
    "groups": {
      "name_entry_latin": [
        {
          "replace": true,
          "start": 203,
          "characters": "0123456789"
        },
        {
          "replace": true,
          "start": 220,
          "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        },
        {
          "replace": true,
          "start": 252,
          "characters": "abcdefghijklmnopqrstuvwxyz"
        }
      ],
      "name_entry_symbols": [
        {
          "replace": true,
          "3": ",",
          "4": ".",
          "6": ":",
          "8": "?",
          "9": "!",
          "17": " ",
          "29": "-",
          "30": "/",
          "38": "'",
          "84": "&"
        }
      ]
    }
  },
  "reference_sets": {
    "ark_latin": [
      {
        "start": 3,
        "characters": ",."
      },
      {
        "start": 6,
        "characters": ":"
      },
      {
        "start": 8,
