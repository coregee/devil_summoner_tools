      },
      {
        "start": 29,
        "characters": "-/"
      },
      {
        "start": 38,
        "characters": "'"
      },
      {
        "start": 84,
        "characters": "&"
      },
      {
        "start": 203,
        "characters": "0123456789"
      },
      {
        "start": 220,
        "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      },
      {
        "start": 252,
        "characters": "abcdefghijklmnopqrstuvwxyz"
      }
    ]
  },
  "repack": {
    "source": "ark-pixel/ark-pixel-16px-proportional-latin.otf",
