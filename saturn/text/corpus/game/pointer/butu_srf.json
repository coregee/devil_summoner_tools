[
  {
    "id": "game.butu_srf.p0000",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "要ラヌワ・・・{n}シマッテオケ。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0001",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "ソレ、イラナイ。{n}オレニハ、イラナイ。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0002",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "我には要り用のない物。{n}もとに収めておくがよろし。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0003",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "ふむ、文字通りつまらないものですね。{n}私は遠慮させていただきましょう。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0004",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "わたくしに、まさかそのような不粋な物が{n}似合うと、お思いではないでしょうね。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0005",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "なんだよそれ、要らねえよそんなもん。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0006",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "なにそれー、あんたバカじゃないの？",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0007",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "子供を物でつるつもりなの？{n}まったく大人ってのは・・・。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0008",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "おじちゃん、あたし、そんなの要らない。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0009",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "まあ、嬉しい。{n}でも、気持ちだけ頂くことにするわね。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0010",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "えへへへへ、いいもんくれんじゃねえか。{n}さっそく捨ててやるよ。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0011",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "ふぉっふぉっふぉっ、{n}そいつは、わしには不用のものじゃのう。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0012",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "キミ、ゴミはくずかごに捨てたまえ。{n}そんなもの渡されても困るんだよ。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0013",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "そんなしょーもないもん、いるか！{n}もっとましなもん、持ってこい。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0014",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "ヌルヌル？{n}ズーズーズズー・・・。",
    "translation": "",
    "note": ""
  },
  {
    "id": "game.butu_srf.p0015",
    "source_encoding": "game_font12_16_combat_skip",
    "output_encoding": "",
    "reference": "・・・・・・・・。",
    "translation": "",
    "note": ""
  },
