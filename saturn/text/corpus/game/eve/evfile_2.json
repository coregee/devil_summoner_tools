  {
    "id": "game.evfile_2.m0045.p00",
    "source_encoding": "game_font12_16_event_skip",
    "output_encoding": "",
    "reference": "ランタン：ややっ、ヒキョウなニンゲンめ！{n}シッポをまいてにげるのか！？",
    "translation": "",
