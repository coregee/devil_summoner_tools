  },
  {
    "id": "game.evfile_2.m0046.p03",
    "source_encoding": "game_font12_16_event_skip",
    "output_encoding": "",
    "reference": "ランタン：いのちがおしくば、もうにどと{n}アクマをいじめないと、ちかえ！",
