  },
  {
    "id": "game.evfile_2.m0046.p01",
    "source_encoding": "game_font12_16_event_skip",
    "output_encoding": "",
    "reference": "オレたち、デビルバスター・バスターズが、{n}タイジしてやるぞ！",
