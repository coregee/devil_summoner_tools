[
  {
    "id": "compendium.race_descriptions.o06abd6.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06abf0.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "現在の中心的な神々．多くの信仰をその身に集め，最高の力を持っている．やや{GLYPH:0500}楽的な神々が多い．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ac62.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "女神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ac7c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "慈愛をもたらす女の神々．愛に{GLYPH:0502}れた優しい性格の持ち主である．高い能力を持っているが，無駄な戦いは好まない．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06acee.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "大天使",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ad08.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "天使たちよりも上位にある精霊たち．かなりの魔力を持ち，破壊神のような恐ろしい存在であるものもいる．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ad7a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "霊鳥",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ad94.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神々の乗り物であったり，聖なる力の昇{GLYPH:0505}を体現するものであったりする，神聖度の高い魔物たち．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ae06.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神樹",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ae20.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神聖な力より生え出でた樹{GLYPH:026e}．穏やかな性格を持ち，他者に恩寵をもたらす．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ae92.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "秘神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06aeac.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "月影の消える夜にだけ現れる，秘められた神々．性愛や排泄などの，人間の隠された部分を司る．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06af1e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "幻魔",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06af38.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔力に優れた神に近い者たち．多様な能力を備えており，変身を得意とする者も多い．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06afaa.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神獣",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06afc4.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神の猛々しい野性の力の現れである，善なる獣たち．邪悪なものとの戦いには，大きな力を発揮する．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b036.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "聖獣",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b050.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "聖なる魔獣たち．瑞兆の現れであったり，神に捧げられる犠牲であったりする．また，神の乗り物である者もいる．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b0c2.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "精霊",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b0dc.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "地・火・水・風の四大（しだい）元素の神格化されたもの．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b14e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "御魂",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b168.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "神や人間の霊を形づくる，荒・和・幸・奇の四魂．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b1da.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "英雄",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b1f4.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "造魔の身体を{GLYPH:063e}りて再び現世に{GLYPH:063f}った，過去の勇者たち．その能力は，もはや人間の域を越えている．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b266.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "破壊神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b280.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔神に対抗する力を持つ神々．破壊と創造の力を{GLYPH:0640}せ持つ．畏怖の念をもって人々に崇拝される．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b2f2.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "地母神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b30c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "母なる大地の女神たち．母の優しさと自然の厳しさの両面を持っている．かなり古い神々でもある．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b37e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "鬼神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b398.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "怒りの姿をとる神々．鬼たちが神の力を得た姿である．その荒ぶる力で，魔という魔を降伏する．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b40a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "龍神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b424.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "龍族の長．神々の中でも最も古き者たちであり，人智を越えた能力と，不思議な{GLYPH:050c}{GLYPH:050d}基準を持っている．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b496.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "天使",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b4b0.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "下級の天使たち．天界の使い{GLYPH:0570}りだが，敵に対しては武器を取り戦う．人間たちの守護者でもある．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b522.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖鳥",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b53c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "人々を誘惑し，気に入ったものをさらっていく，危険な風の魔であるが，本来は魂の運び手であった．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b5ae.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖魔",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b5c8.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔力の強い悪魔たち．その性格は暗いものではなく，光に向いている．自然の力を利用することに長けた者も多い．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b63a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖精",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b654.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "陽気な魔物たち．邪悪にも正義にもあまり興味がなく，自分の好き勝手にやるのが好きなようである．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b6c6.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "龍王",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b6e0.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "龍神には至らないものの，巨大な力を秘めた龍たち．水に関係する特性を持つ傾向がある．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b752.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔獣",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b76c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "直感で生きる獣が，魔と化したもの．危険ではあるが邪悪なものではない．また，従属的な性格の者も少なくない．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b7de.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "珍獣",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b7f8.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "ユーモラスな姿をした，愛すべき獣たち．ただし戦闘の能力のほうは，あまり期{GLYPH:0642}できない．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b86a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "地霊",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b884.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "鬼族であるが，妖精に近く，鬼となる闘気を秘めていない．大地よりその力を得ている．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b8f6.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "夜魔",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b910.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖魔よりもさらに魔力を持つ，恐ろしき夜の魔物たち．人間にとっては最も身近な魔物たちである．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b982.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "堕天使",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06b99c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "かつてセラフ（{GLYPH:0643}天使）との戦いで敗れ，堕ちた天使たち．いわゆる悪魔たちで，デーモンとも呼ばれる．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ba0e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖鬼",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ba28.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "他者に支配されることなく，自らの怒りの原理で行動する鬼たち．どちらかといえば肉体派である．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06ba9a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "鬼女",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bab4.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "破壊をもたらす女魔たち．敵に対しては，容赦のない殺戮を行う．女性らしさをいかした攻撃も得意である．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bb26.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "邪神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bb40.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "陥しめられた神々の中でも，最も邪悪なもの．人間の恐怖や苦悩を求め，破壊を行う．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bbb2.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "凶鳥",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bbcc.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "悪い兆しを運んでくる，不吉な鳥たち．また，人の魂を{GLYPH:0572}うものたちでもある．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bc3e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖樹",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bc58.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "放射能の影響か，意志を持ち，人々に襲いかかる樹{GLYPH:026e}．大地の怒りが体現した姿だとも考えられる．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bcca.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "死神",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bce4.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "人間たちを死に誘う，冥界からの使者．その恐るべき呪力で，痛みを感じる間すら与えずに，命の灯火を消す．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bd56.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖獣",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bd70.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "飽く無き欲望の悪魔．破壊する純{GLYPH:057d}な力の権化である獣たち．その邪悪な牙で襲いかかってくる．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bde2.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "邪鬼",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bdfc.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "邪神に仕える鬼．最低限にまで落ちた神々や精霊．復讐と残虐な欲望の{GLYPH:057f}である．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06be6e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "屍鬼",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06be88.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "悪魔の力によって，歩き回る死体たち．生前の記{GLYPH:058b}が残っているものが多いようである．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06befa.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "妖虫",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bf14.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "虫の姿をとる魔物たち．人間の怨霊が変化したものもいる．その生態は謎だらけである．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bf86.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔王",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06bfa0.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "陥しめられた魔と堕天使を統べる古き神々．{GLYPH:0644}り知れない潜在的な力を持っている．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c012.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "邪龍",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c02c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "知性は無く，破壊と貪欲な食欲の{GLYPH:0575}動に駆られる暗黒のパワーの権化である龍．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c09e.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "幽鬼",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c0b8.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "強烈な怨念により，人が死してもなお姿をとどめ，復讐をなそうとするおぞましい霊．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c12a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "悪霊",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c144.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "幽鬼ほどの実体化ができずにとどまっている怨霊たち．肉体が希薄であるため，攻撃がしづらい．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c1b6.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "外道",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c1d0.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "実体化できない悪魔たち．あるいは悪魔に精神を冒された人間たち．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c242.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "造魔",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c25c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "人造の悪魔．その主人たる者の命令を忠実に遂行する．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c2ce.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "{GLYPH:0018}ODATA",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c2e8.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c35a.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "造魔",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c374.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "人造の悪魔．その主人たる者の命令を忠実に遂行する．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c3e6.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "怨霊",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c400.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "存命時の怨念や現世への執着によってとどまる，死者の霊．必ずしも悪い人間だったわけでは無い．",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c472.heading",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "魔人",
    "translation": "",
    "note": ""
  },
  {
    "id": "compendium.race_descriptions.o06c48c.description",
    "source_encoding": "compendium_font16_plain_skip",
    "output_encoding": "",
    "reference": "恐るべき魔力をもった超人．人間たることに飽き足らず，神あるいは悪魔の領域に踏み込もうとする．",
    "translation": "",
    "note": ""
  },
  {
