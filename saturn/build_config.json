{
  "version": 1,
  "steps": [
    {
      "id": "restore_discs",
      "description": "Restore both extracted disc mirrors before applying generated replacements.",
      "type": "python",
      "script": "rom/extract.py",
      "arguments": ["all", "--overwrite"],
      "check_arguments": null
    },
    {
      "id": "repack_fonts",
      "description": "Rebuild every configured Saturn font and its derived metrics.",
      "type": "python",
      "script": "font/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "install_fonts",
      "description": "Install generated fonts at their exact game and compendium targets.",
      "type": "copy",
      "files": [
        {
          "source": "font/generated/game/FNT12X12.FON",
          "destination": "rom/extracted/game/FNT12X12.FON"
        },
        {
          "source": "font/generated/game/FNT8X12.FON",
          "destination": "rom/extracted/game/FNT8X12.FON"
        },
        {
          "source": "font/generated/game/FONT12.FON",
          "destination": "rom/extracted/game/FONT12.FON"
        },
        {
          "source": "font/generated/game/FONT16.FON",
          "destination": "rom/extracted/game/FONT16.FON"
        },
        {
          "source": "font/generated/game/FONT6.FON",
          "destination": "rom/extracted/game/FONT6.FON"
        },
        {
          "source": "font/generated/game/FONT8.FON",
          "destination": "rom/extracted/game/FONT8.FON"
        },
        {
          "source": "font/generated/game/ICON.FON",
          "destination": "rom/extracted/game/ICON.FON"
        },
        {
          "source": "font/generated/game/KANJI.FON",
          "destination": "rom/extracted/game/KANJI.FON"
        },
        {
          "source": "font/generated/game/KANJI.FON",
          "destination": "rom/extracted/game/MMP/KANJI.FON"
        },
        {
          "source": "font/generated/compendium/FONT16.FON",
          "destination": "rom/extracted/compendium/FONT16.FON"
        }
      ]
    },
    {
      "id": "repack_event_text",
      "description": "Compile the complete general EVENT surface from shared authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["event"],
      "check_arguments": ["event", "--check"]
    },
    {
      "id": "install_event_text",
      "description": "Install the four compiled general EVENT banks.",
      "type": "copy",
      "files": [
        {
          "source": "text/generated/game/MESFILE.EVE",
          "destination": "rom/extracted/game/MESFILE.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_0.EVE",
          "destination": "rom/extracted/game/EVFILE_0.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_1.EVE",
          "destination": "rom/extracted/game/EVFILE_1.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_2.EVE",
          "destination": "rom/extracted/game/EVFILE_2.EVE"
        }
      ]
    },
    {
      "id": "repack_shopsmp_text",
      "description": "Compile the complete shop and facility bank, including every Fusion consumer, from shared authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["shopsmp"],
      "check_arguments": ["shopsmp", "--check"]
    },
    {
      "id": "install_shopsmp_text",
      "description": "Install the compiled shop and facility EVENT bank.",
      "type": "copy",
      "files": [
        {
          "source": "text/generated/game/SHOPSMP.EVE",
          "destination": "rom/extracted/game/SHOPSMP.EVE"
        }
      ]
    },
    {
      "id": "build_fusion_engine",
      "description": "Build the composed EVENT dialogue and Fusion-menu runtime patches.",
      "type": "python",
      "script": "engine/build.py",
      "arguments": ["fusion.menu"],
      "check_arguments": ["fusion.menu", "--check"]
    },
    {
      "id": "install_fusion_engine",
      "description": "Install the composed EVENT runtime required by dialogue and Fusion surfaces.",
      "type": "copy",
      "files": [
        {
          "source": "engine/generated/game/EVENT.BIN",
          "destination": "rom/extracted/game/EVENT.BIN"
        }
      ]
    },
    {
      "id": "repack_battle_negotiation_text",
      "description": "Compile battle-negotiation dialogue, choices, condition lines, and item inserts from shared authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["negotiation"],
      "check_arguments": ["negotiation", "--check"]
    },
    {
      "id": "install_battle_negotiation_text",
      "description": "Install all sixteen battle-negotiation banks.",
      "type": "copy",
      "files": [
        {"source": "text/generated/game/COMBDATA/BOSSTALK.EVE", "destination": "rom/extracted/game/COMBDATA/BOSSTALK.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_BST.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_BST.EVE"},
        {"source": "text/generated/game/COMBDATA/KEMO.EVE", "destination": "rom/extracted/game/COMBDATA/KEMO.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_KOFU.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_KOFU.EVE"},
        {"source": "text/generated/game/COMBDATA/NBL_M.EVE", "destination": "rom/extracted/game/COMBDATA/NBL_M.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_HIRK.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_HIRK.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_YNGM.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_YNGM.EVE"},
        {"source": "text/generated/game/COMBDATA/GRL.EVE", "destination": "rom/extracted/game/COMBDATA/GRL.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_BOY.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_BOY.EVE"},
        {"source": "text/generated/game/COMBDATA/CLD_F.EVE", "destination": "rom/extracted/game/COMBDATA/CLD_F.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_LADY.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_LADY.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_CRZY.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_CRZY.EVE"},
        {"source": "text/generated/game/COMBDATA/JIJY.EVE", "destination": "rom/extracted/game/COMBDATA/JIJY.EVE"},
        {"source": "text/generated/game/COMBDATA/CYNI.EVE", "destination": "rom/extracted/game/COMBDATA/CYNI.EVE"},
        {"source": "text/generated/game/COMBDATA/TLK_WEST.EVE", "destination": "rom/extracted/game/COMBDATA/TLK_WEST.EVE"},
        {"source": "text/generated/game/COMBDATA/SLM.EVE", "destination": "rom/extracted/game/COMBDATA/SLM.EVE"}
      ]
    },
    {
      "id": "repack_battle_ui_text",
      "description": "Compile the battle console, Demon Chat, help, ritual console, and complete item/skill catalogs from authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["battle"],
      "check_arguments": ["battle", "--check"]
    },
    {
      "id": "install_battle_ui_text",
      "description": "Install all six file-backed battle and ritual text consumers.",
      "type": "copy",
      "files": [
        {"source": "text/generated/game/BTL_HELP.DAT", "destination": "rom/extracted/game/BTL_HELP.DAT"},
        {"source": "text/generated/game/BTL_MES.MD8", "destination": "rom/extracted/game/BTL_MES.MD8"},
        {"source": "text/generated/game/BTL_SRF.MDT", "destination": "rom/extracted/game/BTL_SRF.MDT"},
        {"source": "text/generated/game/BUTU_SRF.MDT", "destination": "rom/extracted/game/BUTU_SRF.MDT"},
        {"source": "text/generated/game/ITEMNAME.DAT", "destination": "rom/extracted/game/ITEMNAME.DAT"},
        {"source": "text/generated/game/MAGNAME.DAT", "destination": "rom/extracted/game/MAGNAME.DAT"}
      ]
    },
    {
      "id": "build_battle_ui_engine",
      "description": "Compose the battle UI renderers and packed record readers onto the negotiation runtime.",
      "type": "python",
      "script": "engine/build.py",
      "arguments": ["battle.ui"],
      "check_arguments": ["battle.ui", "--check"]
    },
    {
      "id": "install_battle_ui_engine",
      "description": "Install the composed COMBAT runtime and the ritual-console NORMCOM decoder.",
      "type": "copy",
      "files": [
        {"source": "engine/generated/game/COMBAT.BIN", "destination": "rom/extracted/game/COMBAT.BIN"},
        {"source": "engine/generated/game/NORMCOM.BIN", "destination": "rom/extracted/game/NORMCOM.BIN"}
      ]
    },
    {
      "id": "repack_visuals",
      "description": "Apply every changed visual asset to its extracted disc mirror.",
      "type": "python",
      "script": "visual/repack.py",
      "arguments": ["all"],
      "check_arguments": ["all", "--check"]
    },
    {
      "id": "build_discs",
      "description": "Build and verify both patched BIN/CUE sets.",
      "type": "python",
      "script": "rom/repack.py",
      "arguments": ["all", "--overwrite"],
      "check_arguments": ["all", "--check"]
    }
  ],
  "profiles": {
    "default": {
      "description": "Build the complete translation currently available in this project.",
      "steps": [
        "restore_discs",
        "repack_fonts",
        "install_fonts",
        "repack_event_text",
        "install_event_text",
        "repack_shopsmp_text",
        "install_shopsmp_text",
        "build_fusion_engine",
        "install_fusion_engine",
        "repack_battle_negotiation_text",
        "install_battle_negotiation_text",
        "repack_battle_ui_text",
        "install_battle_ui_text",
        "build_battle_ui_engine",
        "install_battle_ui_engine",
        "repack_visuals",
        "build_discs"
      ],
      "outputs": ["game", "compendium"]
    }
  }
}
