        {
          "source": "font/generated/game/ICON.FON",
          "destination": "rom/extracted/game/ICON.FON"
        },
        {
          "source": "font/generated/game/KANJI.FON",
          "destination": "rom/extracted/game/KANJI.FON"
        },
        {
          "source": "font/generated/game/KANJI.FON",
          "destination": "rom/extracted/game/MMP/KANJI.FON"
        },
        {
          "source": "font/generated/compendium/FONT16.FON",
          "destination": "rom/extracted/compendium/FONT16.FON"
        }
      ]
    },
    {
      "id": "repack_event_text",
      "description": "Compile the complete general EVENT surface from shared authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["event"],
      "check_arguments": ["event", "--check"]
    },
    {
      "id": "install_event_text",
      "description": "Install the four compiled general EVENT banks.",
      "type": "copy",
      "files": [
        {
          "source": "text/generated/game/MESFILE.EVE",
          "destination": "rom/extracted/game/MESFILE.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_0.EVE",
          "destination": "rom/extracted/game/EVFILE_0.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_1.EVE",
          "destination": "rom/extracted/game/EVFILE_1.EVE"
        },
        {
          "source": "text/generated/game/EVFILE_2.EVE",
          "destination": "rom/extracted/game/EVFILE_2.EVE"
        }
      ]
    },
    {
      "id": "repack_shopsmp_text",
      "description": "Compile the complete shop and facility bank, including every Fusion consumer, from shared authored assets.",
      "type": "python",
      "script": "text/repack.py",
      "arguments": ["shopsmp"],
      "check_arguments": ["shopsmp", "--check"]
    },
    {
      "id": "install_shopsmp_text",
      "description": "Install the compiled shop and facility EVENT bank.",
      "type": "copy",
      "files": [
