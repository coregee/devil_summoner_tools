{
  "version": 1,
  "kind": "surface_catalog",
  "entries": {
    "dialogue_0000": {
      "text": {
        "reference": "オイ、ショウカンシ、{n}ナニカイッタカ？{demon_name}",
        "translation": "HEY, SUMMONER...{n}YOU SAY SOMETHING?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0001": {
      "text": {
        "reference": "ア～、ダル～。{n}チョット、マッテクレ。{demon_name}",
        "translation": "UGH... SO TIRED...{n}WAIT A LITTLE.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0002": {
      "text": {
        "reference": "なにゆえ、そなたは{n}戦うのじゃ？{demon_name}",
        "translation": "Why do you fight?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0003": {
      "text": {
        "reference": "高みの見物とでも、{n}シャレこもうか。{demon_name}",
        "translation": "I'll sit back and{n}enjoy the show.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0004": {
      "text": {
        "reference": "誰に命令しているのか、{n}わかっていらっしゃる？{demon_name}",
        "translation": "Do you know who{n}you're ordering around?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0005": {
      "text": {
        "reference": "なあ、俺、後で、{n}合体させられんの？{demon_name}",
        "translation": "Hey, are you going to{n}fuse me later?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0006": {
      "text": {
        "reference": "やっだ、もー、足首、{n}いった～い。{demon_name}",
        "translation": "Oh, come on!{n}My ankles hurt!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0007": {
      "text": {
        "reference": "おじさんさー、だれでも{n}殺っちゃうんだね。{demon_name}",
        "translation": "You'll kill anyone,{n}won't you, pops?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0008": {
      "text": {
        "reference": "おじちゃんってさあ、{n}らんぼう・・・だよね。{demon_name}",
        "translation": "You're pretty violent,{n}aren't you, mister?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0009": {
      "text": {
        "reference": "ねえ、口紅はげてないか{n}見てくれない？{demon_name}",
        "translation": "Hey, has my lipstick{n}come off? Take a look.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0010": {
      "text": {
        "reference": "ボイコットは人の名だ。{n}・・・知ってた？{demon_name}",
        "translation": "Boycott was a man's name.{n}Did you know that?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0011": {
      "text": {
        "reference": "そんなことよりなー、{n}若いの、はげんどるか？{demon_name}",
        "translation": "More importantly, young man...{n}Keeping at it?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0012": {
      "text": {
        "reference": "自分が何をしているか、{n}わかっているんですか？{demon_name}",
        "translation": "Do you understand{n}what you're doing?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0013": {
      "text": {
        "reference": "そんなことゆ～ても、{n}やらへんで～。{demon_name}",
        "translation": "Say what you like.{n}I still won't do it.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0014": {
      "text": {
        "reference": "ズズー！ズズー！{demon_name}",
        "translation": "SLURP! SLURP!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0015": {
      "text": {
        "reference": "・・・・・・・・。{demon_name}",
        "translation": "........{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0016": {
      "text": {
        "reference": "イイカラ、ワタシニ{n}マカセロ。{demon_name}",
        "translation": "ENOUGH.{n}LEAVE TO ME.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0017": {
      "text": {
        "reference": "オレサマ、メイレイ、{n}キライ、ダマッテロ。{demon_name}",
        "translation": "ME HATE ORDERS.{n}YOU SHUT UP.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0018": {
      "text": {
        "reference": "我に命令するとは、{n}おろかしい奴よのう。{demon_name}",
        "translation": "How foolish of you{n}to give me orders.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0019": {
      "text": {
        "reference": "こうするのが、最も、{n}合理的な方法なのだ。{demon_name}",
        "translation": "This is the most{n}rational course of action.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0020": {
      "text": {
        "reference": "わたくし、やりたい事を{n}させて頂くわ。{demon_name}",
        "translation": "I shall do{n}as I please.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0021": {
      "text": {
        "reference": "お前なー、命令すんのは{n}召喚だけにしとけよ。{demon_name}",
        "translation": "The only order you get{n}to give is 'Summon.'{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0022": {
      "text": {
        "reference": "あんた、けっこう、{n}口うるさいのね。{demon_name}",
        "translation": "You're awfully bossy,{n}aren't you?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0023": {
      "text": {
        "reference": "ボクねー、おじさん、{n}シンヨーできないなぁ。{demon_name}",
        "translation": "I don't trust you,{n}mister.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0024": {
      "text": {
        "reference": "おじちゃんのいうこと、{n}ときどきわかんなぁい。{demon_name}",
        "translation": "Sometimes I don't get{n}what you say, mister.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0025": {
      "text": {
        "reference": "クリスマスに、一人で{n}いたい、女もいるのよ。{demon_name}",
        "translation": "Some women want to be{n}alone on Christmas.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0026": {
      "text": {
        "reference": "おまえは、オレレレレ、{n}オレじゃねえんだよ。{demon_name}",
        "translation": "You're... m-me-me-me...{n}You're not me!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0027": {
      "text": {
        "reference": "ヒャッヒャッヒャ～、{n}若いもんは、黙っとれ。{demon_name}",
        "translation": "Heh heh heh!{n}Quiet, youngster.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0028": {
      "text": {
        "reference": "違うなぁ、キミには{n}わからないのかなぁ？{demon_name}",
        "translation": "No, no. Do you truly{n}not understand?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0029": {
      "text": {
        "reference": "こんなもんで・・・、{n}ええやろ？{demon_name}",
        "translation": "This'll do...{n}Right?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0030": {
      "text": {
        "reference": "ズル？{demon_name}",
        "translation": "SLURP?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0031": {
      "text": {
        "reference": "・・・・・・・・。{demon_name}",
        "translation": "........{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0032": {
      "text": {
        "reference": "オマエノ命令、{n}ゼッタイ、聞カナイ！{demon_name}",
        "translation": "YOUR ORDERS...{n}ME NEVER OBEY!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0033": {
      "text": {
        "reference": "メイレイ、イヤ！！{n}オマエ、黙ル、イイ！{demon_name}",
        "translation": "ORDERS, BAD!{n}YOU SHUT UP! GOOD!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0034": {
      "text": {
        "reference": "そこまで突っ込んだ{n}命令は聞かん！！{demon_name}",
        "translation": "I won't take orders{n}that detailed!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0035": {
      "text": {
        "reference": "私に指図は必要ない。{n}よって命令は無視する！{demon_name}",
        "translation": "I need no direction.{n}Your order is ignored!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0036": {
      "text": {
        "reference": "そこまでの指図は、{n}聞けないですわ！！{demon_name}",
        "translation": "I cannot follow an order{n}that presumptuous!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0037": {
      "text": {
        "reference": "そこまでいうなら、{n}俺はこうする。{demon_name}",
        "translation": "If you insist,{n}then I'll do this.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0038": {
      "text": {
        "reference": "そんな命令、グッバイ、{n}さよならってカンジー。{demon_name}",
        "translation": "That order? Goodbye,{n}farewell, see ya!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0039": {
      "text": {
        "reference": "あれしろ、これしろ、{n}やだぁー！もー！！{demon_name}",
        "translation": "Do this, do that...{n}No! Enough already!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0040": {
      "text": {
        "reference": "ゴーでいいったら！！{n}ゴーにしてよぉ～！！{demon_name}",
        "translation": "I said GO!{n}Set me to GO!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0041": {
      "text": {
        "reference": "言いなりは絶対にイヤ！{n}かまわないで！！{demon_name}",
        "translation": "I refuse to obey!{n}Leave me alone!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0042": {
      "text": {
        "reference": "やい、召喚師・・・、{n}GOにしとけよ！！{demon_name}",
        "translation": "Hey, Summoner...{n}Just set me to GO!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0043": {
      "text": {
        "reference": "若い者のたわごとなぞ、{n}聞かんのじゃい！！{demon_name}",
        "translation": "I won't heed a{n}youngster's nonsense!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0044": {
      "text": {
        "reference": "信用がないんですね。{n}ご命令は却下します。{demon_name}",
        "translation": "You show no trust.{n}Your order is denied.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0045": {
      "text": {
        "reference": "えらい、召喚師やな。{n}聞かへんで。{demon_name}",
        "translation": "Some Summoner you are.{n}I'm not listening.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0046": {
      "text": {
        "reference": "ズル！ズルル！{demon_name}",
        "translation": "SLURP! SLURRRP!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0047": {
      "text": {
        "reference": "・・・・・・・・。{demon_name}",
        "translation": "........{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0048": {
      "text": {
        "reference": "ワカラヌ奴・・・{n}・・・キカヌ。{demon_name}",
        "translation": "YOU NEVER LEARN...{n}ME NOT LISTEN.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0049": {
      "text": {
        "reference": "コマンドイレスギ！！{n}・・コマンド、ッテ？{demon_name}",
        "translation": "TOO MANY COMMANDS!{n}...WHAT IS COMMAND?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0050": {
      "text": {
        "reference": "いやじゃ！！{n}聞きとうない！！{demon_name}",
        "translation": "No!{n}I don't want to hear it!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0051": {
      "text": {
        "reference": "「GO」を待っている。{demon_name}{n}それまではこうだ！！",
        "translation": "I'm waiting for GO.{n}Until then, I do this!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0052": {
      "text": {
        "reference": "残念でしたわね！{n}全部、あなたのせいよ！{demon_name}",
        "translation": "Too bad!{n}It's all your fault!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0053": {
      "text": {
        "reference": "やるよ、やるよ、{n}でも、こーんなの。{demon_name}",
        "translation": "Fine, fine, I'll act...{n}But like this.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0054": {
      "text": {
        "reference": "ざったいわねー。{n}聞きゃしないわよ！！{demon_name}",
        "translation": "You're so fussy.{n}I'm not listening!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0055": {
      "text": {
        "reference": "子供を責めると、{n}手がつけられんじょー！{demon_name}",
        "translation": "Pick on a child and{n}I'll throw a tantrum!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0056": {
      "text": {
        "reference": "ゴーがいいったら～！！{n}好きにさせてよぅ！！{demon_name}",
        "translation": "I said GO!{n}Let me do what I want!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0057": {
      "text": {
        "reference": "し～た～が～い～{n}ま～せ～ん～。ね？{demon_name}",
        "translation": "I~ won't~ o~bey~.{n}Okay?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0058": {
      "text": {
        "reference": "う、う、うがっー！！{demon_name}",
        "translation": "U-u-ugahhh!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0059": {
      "text": {
        "reference": "召喚師がそれじゃの～、{n}命令なぞ、無視じゃ！！{demon_name}",
        "translation": "With a Summoner like you,{n}I'll ignore every order!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0060": {
      "text": {
        "reference": "あなたは自己チュウ？{n}私は自己チュウです。{demon_name}",
        "translation": "You're self-centered?{n}So am I.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0061": {
      "text": {
        "reference": "そこまで指示しといて、{n}わしは、これやがな。{demon_name}",
        "translation": "After all those instructions,{n}this is what I'm doing.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0062": {
      "text": {
        "reference": "ズズッ！ズズズッ！！{demon_name}",
        "translation": "SLURP! SLURRRRP!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0063": {
      "text": {
        "reference": "・・・・・・・・。{demon_name}",
        "translation": "........{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0064": {
      "text": {
        "reference": "ナニカ変ナ、気分ダナ。{demon_name}",
        "translation": "SOMETHING FEEL...{n}STRANGE.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0065": {
      "text": {
        "reference": "ムラムラムラ。{n}オレッテ・・イッタイ。{demon_name}",
        "translation": "ME ALL WORKED UP...{n}WHAT HAPPEN TO ME?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0066": {
      "text": {
        "reference": "どうしてか、ココロ{n}はりさけそうじゃ！！{demon_name}",
        "translation": "Why does my heart feel{n}as if it will burst?!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0067": {
      "text": {
        "reference": "・・・すまぬ！{demon_name}",
        "translation": "...Forgive me!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0068": {
      "text": {
        "reference": "わたくしときたら、{n}心乱れて・・・。{demon_name}",
        "translation": "How unlike me...{n}My heart is in turmoil.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0069": {
      "text": {
        "reference": "ムラムラすんぜぇ～、{n}ちきしょー！！{demon_name}",
        "translation": "I'm getting all worked up,{n}damn it!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0070": {
      "text": {
        "reference": "ちょっと、やだぁ～、{n}私、変になっちゃった。{demon_name}",
        "translation": "Oh no...{n}Something's come over me.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0071": {
      "text": {
        "reference": "おじさんたち、{n}しんじゃえー！！{demon_name}",
        "translation": "You old guys{n}can all die!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0072": {
      "text": {
        "reference": "おじちゃんたち、{n}しんじゃえー！！{demon_name}",
        "translation": "You old guys{n}can all die!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0073": {
      "text": {
        "reference": "あたしは、夜の蝶。{n}浮気なLady。{demon_name}",
