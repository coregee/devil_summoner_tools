      "text": {
        "reference": "逃げるのカ・{demon_name}・{demon_name}・{demon_name}",
        "translation": "You are fleeing?{demon_name}{demon_name}{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0147": {
      "text": {
        "reference": "逃げるのか・{demon_name}・{demon_name}・{demon_name}",
        "translation": "You're running away?{demon_name}{demon_name}{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0148": {
      "text": {
        "reference": "ソレモヨカロウ。{demon_name}",
        "translation": "THAT ALSO GOOD.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0149": {
      "text": {
        "reference": "オモワナカッタ！！{demon_name}",
        "translation": "ME NOT EXPECT THAT!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0150": {
      "text": {
        "reference": "我、再会を望むなり。{demon_name}",
        "translation": "I hope we meet again.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0151": {
      "text": {
        "reference": "私の前に現れるな！！{demon_name}",
        "translation": "Never show yourself{n}before me again!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0152": {
      "text": {
        "reference": "なら、逃げるがいいわ。{demon_name}",
        "translation": "Then flee.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0153": {
      "text": {
        "reference": "今回は見逃してやるぜ。{demon_name}",
        "translation": "I'll let you go this time.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0154": {
      "text": {
        "reference": "なら、また今度ね・・。{demon_name}",
        "translation": "Well, until next time...{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0155": {
      "text": {
        "reference": "ウシャー！覚えとき！{demon_name}",
        "translation": "Hah! Remember this!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0156": {
      "text": {
        "reference": "行っちゃえ！しっしっ！{demon_name}",
        "translation": "Go on! Shoo, shoo!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0157": {
      "text": {
        "reference": "さみしくなるわね・・。{demon_name}",
        "translation": "I'll be lonely without you...{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0158": {
      "text": {
        "reference": "キャーーー！！{demon_name}",
        "translation": "EEEEK!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0159": {
      "text": {
        "reference": "待てといっとろーが！！{demon_name}",
        "translation": "I told you to wait!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0160": {
      "text": {
        "reference": "やはり、下らん奴だ。{demon_name}",
        "translation": "As I thought, you're worthless.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0161": {
      "text": {
        "reference": "この辺にしといたろか。{demon_name}",
        "translation": "I'll leave it at that.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0162": {
      "text": {
        "reference": "ズズー。{demon_name}",
        "translation": "SLURP.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0163": {
      "text": {
        "reference": "造魔",
        "translation": "Zoma"
      }
    },
    "dialogue_0164": {
      "text": {
        "reference": "ノガサヌ。{demon_name}",
        "translation": "NOT LET YOU ESCAPE.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0165": {
      "text": {
        "reference": "オモウナ！！{demon_name}",
        "translation": "DO NOT THINK YOU CAN!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0166": {
      "text": {
        "reference": "逃さぬも、また策なり。{demon_name}",
        "translation": "Preventing escape is{n}also a strategy.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0167": {
      "text": {
        "reference": "生きては帰しません。{demon_name}",
        "translation": "You will not leave alive.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0168": {
      "text": {
        "reference": "いいから死になさい。{demon_name}",
        "translation": "Just die already.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0169": {
      "text": {
        "reference": "甘いねぇ。{demon_name}",
        "translation": "How naive.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0170": {
      "text": {
        "reference": "勝手すぎない？{demon_name}",
        "translation": "Isn't that rather selfish?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0171": {
      "text": {
        "reference": "どんくさぁ～。{demon_name}",
        "translation": "How clumsy!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0172": {
      "text": {
        "reference": "このイヌっころめ～！！{demon_name}",
        "translation": "You mangy mutt!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0173": {
      "text": {
        "reference": "私、まだ足りないわ！！{demon_name}",
        "translation": "I haven't had enough!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0174": {
      "text": {
        "reference": "まだだ！！{demon_name}",
        "translation": "Not yet!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0175": {
      "text": {
        "reference": "よしよし、いい子じゃ。{demon_name}",
        "translation": "There, there. Good child.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0176": {
      "text": {
        "reference": "それで？{demon_name}",
        "translation": "And?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0177": {
      "text": {
        "reference": "にがさへんで～！！{demon_name}",
        "translation": "I won't let ya get away!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0178": {
      "text": {
        "reference": "ヌ・ヌ・ヌル？{demon_name}",
        "translation": "S-S-SQUELCH?{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0179": {
      "text": {
        "reference": "造魔",
        "translation": "Zoma"
      }
    },
    "dialogue_0180": {
      "text": {
        "reference": "！！！！！{demon_name}",
        "translation": "!!!!!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0181": {
      "text": {
        "reference": "ウワーッハーッハーッ。{demon_name}",
        "translation": "WAH-HA-HA-HA!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0182": {
      "text": {
        "reference": "その力、示してみよ！{demon_name}",
        "translation": "Show me your power!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0183": {
      "text": {
        "reference": "ニゲラレンゾー！{demon_name}",
        "translation": "YOU CANNOT ESCAPE!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0184": {
      "text": {
        "reference": "無駄だ、無駄だ。{demon_name}",
        "translation": "Futile. Utterly futile.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0185": {
      "text": {
        "reference": "無駄なことは、おやめ。{demon_name}",
        "translation": "Do stop wasting your effort.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0186": {
      "text": {
        "reference": "敵前逃亡は銃殺だ！{demon_name}",
        "translation": "Desertion is punishable{n}by firing squad!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0187": {
      "text": {
        "reference": "殺すぞ！{demon_name}",
        "translation": "I'll kill you!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0188": {
      "text": {
        "reference": "オマエヲ殺ス。{demon_name}",
        "translation": "KILL YOU.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0189": {
      "text": {
        "reference": "今度は容赦しませんヨ。{demon_name}",
        "translation": "Next time, I won't be lenient.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0190": {
      "text": {
        "reference": "私のエナジーとなれ。{demon_name}",
        "translation": "Become my energy.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0191": {
      "text": {
        "reference": "わたしの歌を聞いてね。{demon_name}",
        "translation": "Listen to my song.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0192": {
      "text": {
        "reference": "このサウンドを聞けぇ！{demon_name}",
        "translation": "Listen to this sound!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0193": {
      "text": {
        "reference": "逃亡犯は死刑だ。{demon_name}",
        "translation": "Fugitives are put to death.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0194": {
      "text": {
        "reference": "桃園の誓いにかけても！{demon_name}",
        "translation": "By the Oath of{n}the Peach Garden!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0195": {
      "text": {
        "reference": "そうはいかん。{demon_name}",
        "translation": "I think not.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0196": {
      "text": {
        "reference": "逃げられぬぞ。{demon_name}",
        "translation": "There is no escape.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0197": {
      "text": {
        "reference": "やはり中身はニセ者か。{demon_name}",
        "translation": "So the man inside{n}is an impostor after all.{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0198": {
      "text": {
        "reference": "イナルナ姫が復活するゾ{demon_name}",
        "translation": "Princess Inaruna will rise!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0199": {
      "text": {
        "reference": "わらわに血を捧げよ！{demon_name}",
        "translation": "Offer me your blood!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0200": {
      "text": {
        "reference": "わぁ、おとすおちる{n}こわれるうっ！！{demon_name}",
        "translation": "Whoa! Don't drop it!{n}It'll break!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0201": {
      "text": {
        "reference": "こんないいものを{n}なげるなぁっ！！{demon_name}",
        "translation": "Don't throw something{n}this valuable!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    },
    "dialogue_0202": {
      "text": {
        "reference": "モノの値うちのわからん{n}クズどもめ覚悟しろ！{demon_name}",
        "translation": "You scum who know no value,{n}prepare yourselves!{demon_name}"
      },
      "placeholders": {
        "demon_name": "demon_name"
      }
    }
  }
}
